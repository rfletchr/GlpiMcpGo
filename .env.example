# Site URL or the full .../apirest.php URL
GLPI_URL=https://glpi.example.local
# The service user's "API token" (User > Remote access keys)
GLPI_USER_TOKEN=
# Only needed if the GLPI API client requires an application token
GLPI_APP_TOKEN=
# Optional: PEM bundle to trust for a private CA, or 1 to skip verification (not recommended)
GLPI_CA_FILE=
GLPI_INSECURE_TLS=0

# Set to 1 to register the write tools (create/update project/task, assign task).
# Each previews by default; apply=true commits. The token must also have GLPI rights to write.
GLPI_ALLOW_WRITE=0
